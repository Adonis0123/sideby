{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/menubar-reset.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "account",
    "url",
    "opened"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "account": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "description": "The page that was opened: the Panel on this account's limit reset confirmation, or the vendor's page where a limit reset is used. Opening it uses nothing."
    },
    "opened": {
      "type": "boolean"
    },
    "profile": {
      "type": "string",
      "description": "The Browser Profile it opened in, when not the default browser."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
