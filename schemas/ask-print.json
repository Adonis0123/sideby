{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/ask-print.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "prompt",
    "removedSecrets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "prompt": {
      "type": "string",
      "description": "The Task Prompt the Host would get, attachments section included."
    },
    "removedSecrets": {
      "type": "boolean",
      "description": "Whether key-shaped text was taken out of the prompt."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby ask --spec - --print --json"
}
