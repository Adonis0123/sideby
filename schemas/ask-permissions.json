{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/ask-permissions.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "permissions",
    "file"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "permissions": {
      "type": "string",
      "enum": [
        "checked",
        "account"
      ],
      "description": "Config `ask.permissions` now (ADR-0070): `checked` (the default) keeps the Host's permission checks on in AI Tasks; `account` starts them with the Account's own arguments, as `sideby run` does."
    },
    "file": {
      "type": "string",
      "description": "The config file, with `~` for the home folder."
    },
    "changed": {
      "type": "boolean",
      "description": "With a value: the setting would change."
    },
    "applied": {
      "type": "boolean",
      "description": "False when only the change was shown; run again with --yes (exit 10)."
    },
    "before": {
      "type": "string",
      "enum": [
        "checked",
        "account"
      ]
    },
    "after": {
      "type": "string",
      "enum": [
        "checked",
        "account"
      ]
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby ask --permissions [checked|account] [--yes] --json"
}
