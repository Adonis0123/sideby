{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/remote-control.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "action"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "action": {
      "anyOf": [
        {
          "type": "string",
          "const": "status"
        },
        {
          "type": "string",
          "const": "on"
        },
        {
          "type": "string",
          "const": "off"
        },
        {
          "type": "string",
          "const": "undo"
        }
      ]
    },
    "applied": {
      "type": "boolean",
      "description": "True once the change was written (or undone)."
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "accounts",
          "state",
          "undo"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Claude accounts whose settings.json is this file."
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "const": "on"
              },
              {
                "type": "string",
                "const": "default"
              },
              {
                "type": "string",
                "const": "off"
              },
              {
                "type": "string",
                "const": "missing"
              },
              {
                "type": "string",
                "const": "blocked"
              }
            ],
            "description": "on: remoteControlAtStartup is true; default: not set; off: false; missing: no settings.json; blocked: cannot be changed safely (see reason)."
          },
          "reason": {
            "type": "string"
          },
          "undo": {
            "type": "boolean",
            "description": "sideby turned it off here and can put the earlier value back."
          }
        }
      },
      "description": "For status, every file; for a preview, the files that would change."
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "accounts",
          "ok",
          "message"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "message": {
      "type": "string"
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby remote-control [off|undo] --json"
}
