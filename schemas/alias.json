{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/alias.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "alias",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean",
      "description": "False when a config `shellInitFile` was not rewritten."
    },
    "alias": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "added"
        },
        {
          "type": "string",
          "const": "exists"
        },
        {
          "type": "string",
          "const": "removed"
        },
        {
          "type": "string",
          "const": "absent"
        }
      ]
    },
    "account": {
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Host arguments `sideby run <alias>` adds."
    },
    "shellInitFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shell",
          "path",
          "ok"
        ],
        "properties": {
          "shell": {
            "anyOf": [
              {
                "type": "string",
                "const": "zsh"
              },
              {
                "type": "string",
                "const": "bash"
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "const": "written"
              },
              {
                "type": "string",
                "const": "unchanged"
              }
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "description": "One entry per config `shellInitFile`, rewritten after the change."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby alias add|rm --json"
}
