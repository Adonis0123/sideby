{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/sessions-open-run.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "opened",
    "board",
    "sessionId",
    "label"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "opened": {
      "type": "boolean",
      "const": true,
      "description": "The Run Board was handed to the default program; a failure is an error instead."
    },
    "board": {
      "type": "string",
      "description": "The Run Board file opened, with the home folder as ~."
    },
    "sessionId": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "The Session Label of the session whose run report was opened."
    },
    "handedOverFrom": {
      "type": "string",
      "description": "The session id that was named, when an Auto Handoff chain led from it to this session (ADR-0057)."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby sessions open-run --json"
}
