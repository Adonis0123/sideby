{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/pin.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ref",
    "pinned",
    "changed",
    "message",
    "display"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ref": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "display": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accounts": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "pinned": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
