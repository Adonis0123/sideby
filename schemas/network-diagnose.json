{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/network-diagnose.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkedAt",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "checkedAt": {
      "type": "string",
      "description": "When this offline diagnosis ran (ISO), not the Guard cache time."
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "proxy",
          "guardSupport",
          "listener",
          "guard"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "The Guard trace address whose cached result is shown; it is not requested."
          },
          "proxy": {
            "type": "string",
            "description": "Selected proxy reduced to scheme, hostname and port, or direct/invalid."
          },
          "guardSupport": {
            "anyOf": [
              {
                "type": "string",
                "const": "direct"
              },
              {
                "type": "string",
                "const": "http-connect"
              },
              {
                "type": "string",
                "const": "unsupported"
              },
              {
                "type": "string",
                "const": "invalid"
              }
            ],
            "description": "Guard supports direct and HTTP CONNECT; SOCKS/HTTPS proxies are unsupported."
          },
          "listener": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "host",
                  "port",
                  "reachable"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "reachable": {
                    "type": "boolean",
                    "description": "TCP connect only; not proof that the proxy protocol works."
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            ],
            "description": "Local loopback TCP listener only; null for direct, remote or invalid proxies, and non-HTTP proxies without an explicit port."
          },
          "guard": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "ok"
                  },
                  {
                    "type": "string",
                    "const": "blocked"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  },
                  {
                    "type": "string",
                    "const": "not-checked"
                  }
                ]
              },
              "loc": {
                "type": "string"
              },
              "checkedAt": {
                "type": "string",
                "description": "When the cached Guard check ran (ISO)."
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby network diagnose --json"
}
