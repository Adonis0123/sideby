{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/quota.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "accounts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "kind",
          "quota",
          "usage"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "subscription"
              },
              {
                "type": "string",
                "const": "api"
              }
            ]
          },
          "quota": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "status",
                  "windows",
                  "observedAt",
                  "source"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ok"
                  },
                  "windows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "label",
                        "windowMinutes",
                        "usedPercent",
                        "resetsAt"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string",
                          "description": "The group of models this limit covers, when it covers only some (spec §3.26); it does not count toward Quota Pressure."
                        },
                        "windowMinutes": {
                          "type": "number"
                        },
                        "usedPercent": {
                          "type": "number"
                        },
                        "resetsAt": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "observedAt": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "plan": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "description": "The account this reading was taken from, when it is another account of the same login (spec §3.21); observedAt is its time."
                  },
                  "fetched": {
                    "type": "boolean",
                    "description": "This reading is the kept answer of a quota check that costs a request (spec §3.26)."
                  },
                  "fetchError": {
                    "type": "string",
                    "description": "Why the latest quota check failed, while this older reading is shown."
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "unavailable"
                  },
                  "reason": {
                    "type": "string",
                    "description": "not-enabled, no-session, unrecognized, no-source, api-account or fetch-failed."
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "usage": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "status",
                  "days",
                  "sessions",
                  "inputTokens",
                  "outputTokens",
                  "cacheReadTokens",
                  "cacheWriteTokens",
                  "totalTokens"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ok"
                  },
                  "days": {
                    "type": "number"
                  },
                  "sessions": {
                    "type": "number"
                  },
                  "inputTokens": {
                    "type": "number"
                  },
                  "outputTokens": {
                    "type": "number"
                  },
                  "cacheReadTokens": {
                    "type": "number"
                  },
                  "cacheWriteTokens": {
                    "type": "number"
                  },
                  "totalTokens": {
                    "type": "number"
                  },
                  "daily": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "date",
                        "totalTokens"
                      ],
                      "properties": {
                        "date": {
                          "type": "string"
                        },
                        "totalTokens": {
                          "type": "number"
                        }
                      }
                    },
                    "description": "Tokens per local day (YYYY-MM-DD), oldest first, days without records as 0."
                  },
                  "lastActivityAt": {
                    "type": "string"
                  },
                  "lastModel": {
                    "type": "string"
                  },
                  "lastEffort": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "unavailable"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby quota --json"
}
