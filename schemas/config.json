{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/config.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "accounts": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "description": "Per-Account settings keyed by `<family>:<name>`."
    },
    "aliases": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_-]*$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "account"
              ],
              "properties": {
                "account": {
                  "type": "string",
                  "pattern": "^[^:]+:.+$",
                  "description": "The Account ref, `<family>:<name>`."
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Host arguments `sideby run <alias>` adds after the Account `args`, before the user’s."
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "description": "Short shell function names created by `sideby shell-init`, mapped to an Account ref or to `{ account, args }`."
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Account refs that are not Accounts."
    },
    "pluginDirs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Absolute or `~/` paths of Plugin directories."
    },
    "plugins": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        }
      },
      "description": "Per-Plugin settings; `enabled: false` turns a Plugin off."
    },
    "extraSharedItems": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "link"
                  },
                  {
                    "type": "string",
                    "const": "copy"
                  },
                  {
                    "type": "string",
                    "const": "link-or-copy"
                  },
                  {
                    "type": "string",
                    "const": "link-or-local"
                  },
                  {
                    "type": "string",
                    "const": "local"
                  },
                  {
                    "type": "string",
                    "const": "local-if-api"
                  },
                  {
                    "type": "string",
                    "const": "info"
                  }
                ]
              },
              "noSymlink": {
                "type": "boolean"
              },
              "credential": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "accountTitle": {
      "type": "boolean",
      "description": "Set the terminal title to `[<short command or account>]` when sideby starts an Account, and keep Hosts that allow it (Codex) from replacing it. Off by default."
    },
    "resumeRouting": {
      "type": "boolean",
      "description": "Make `sideby shell-init` also define Host-named functions (`claude`, `codex`, `grok`) that resume a session by id in the Account that holds it. Off by default."
    },
    "handoff": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean",
          "description": "Hand a running session to the next account when its Quota runs low: only to other families and API accounts unless `sameFamily` is on. Off by default."
        },
        "sameFamily": {
          "type": "boolean",
          "description": "Also hand off to an account of the same family (cc001 → cc002). The kind vendors are most likely to act on. Off by default."
        },
        "prepareAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Quota Pressure at which the session starts keeping a Handoff Brief (default 80)."
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Quota Pressure at which the Handoff begins (default 95)."
        },
        "waitIfResetWithinMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Stay and wait when the full window resets within this many minutes (default 30; 0 never waits)."
        },
        "countdownSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Countdown before the next account starts; Enter cancels (default 10; 0 skips it)."
        },
        "crossOrganization": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Accounts (ref or short command) that may take over from an account of another organization."
        },
        "families": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "properties": {
                "policy": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "pressure"
                    },
                    {
                      "type": "string",
                      "const": "order"
                    }
                  ]
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "description": "Handoff Order per family the session starts in: `pressure` (default) or an `order` list."
        }
      },
      "additionalProperties": false
    },
    "shellInitFile": {
      "type": "object",
      "properties": {
        "zsh": {
          "type": "string",
          "minLength": 1
        },
        "bash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Absolute or `~/` paths of files sideby rewrites with the `sideby shell-init <shell>` output whenever it adds an Account or an alias; source the file from your shell rc."
    }
  },
  "additionalProperties": false,
  "title": "sideby config"
}
