{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/browser-switch.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "enabled",
    "changed",
    "applied",
    "file",
    "reads"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "The value asked for."
    },
    "changed": {
      "type": "boolean"
    },
    "applied": {
      "type": "boolean",
      "description": "False when only the change was shown; run again with --yes (exit 10)."
    },
    "file": {
      "type": "string",
      "description": "The config file."
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What sideby reads while it is on, all on this computer."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby browser --enable|--disable --json"
}
