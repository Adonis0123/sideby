                              {
                                "type": "null"
                              }
                            ]
                          },
                          "reset": {
                            "type": "string"
                          },
                          "tip": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "A Host whose every limit covers one model group: a line per group under the account, each with its own bars; the account's `bars` are then null."
