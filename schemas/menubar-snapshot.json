                                  "type": "string"
                                },
                                "percent": {
                                  "type": "number"
                                },
                                "level": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "const": "ok"
                                    },
                                    {
                                      "type": "string",
                                      "const": "warn"
                                    },
                                    {
                                      "type": "string",
                                      "const": "fail"
                                    },
                                    {
                                      "type": "string",
                                      "const": "none"
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        {
                          "anyOf": [
                            {
                              "type": "object",
                              "required": [
                                "label",
                                "percent",
                                "level"
                              ],
                              "properties": {
                                "label": {
                                  "type": "string"
                                },
                                "percent": {
                                  "type": "number"
                                },
                                "level": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "const": "ok"
                                    },
                                    {
                                      "type": "string",
                                      "const": "warn"
                                    },
                                    {
                                      "type": "string",
                                      "const": "fail"
                                    },
                                    {
                                      "type": "string",
                                      "const": "none"
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      ],
                      "minItems": 2
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The shorter window, then the longer one; a single window fills the second. Null without quota."
                },
                "groups": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "bars",
                          "reset",
                          "tip"
                        ],
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "bars": {
                            "anyOf": [
                              {
                                "type": "array",
                                "additionalItems": false,
                                "items": [
