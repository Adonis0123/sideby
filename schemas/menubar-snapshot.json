{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/menubar-snapshot.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "level",
    "tooltip",
    "updatedAt",
    "lang",
    "card",
    "hotkey",
    "headline",
    "sections",
    "labels"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "description": "The words next to the icon, such as `Codex 62%`, once the tightest tool reaches 60%; empty otherwise."
    },
    "level": {
      "anyOf": [
        {
          "type": "string",
          "const": "ok"
        },
        {
          "type": "string",
          "const": "warn"
        },
        {
          "type": "string",
          "const": "fail"
        },
        {
          "type": "string",
          "const": "none"
        }
      ]
    },
    "tooltip": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "description": "When this snapshot was made (ISO)."
    },
    "lang": {
      "anyOf": [
        {
          "type": "string",
          "const": "en"
        },
        {
          "type": "string",
          "const": "zh"
        }
      ]
    },
    "card": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "detail",
            "level"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "level": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "ok"
                },
                {
                  "type": "string",
                  "const": "warn"
                },
                {
                  "type": "string",
                  "const": "fail"
                },
                {
                  "type": "string",
                  "const": "none"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The card at the top of the menu: a bold status and a line naming the account; null without quota data."
    },
    "hotkey": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "keyCode",
            "modifiers",
            "label"
          ],
          "properties": {
            "keyCode": {
              "type": "number"
            },
            "modifiers": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The shortcut that opens the menu (config `menubar.hotkey`): a macOS key code and Carbon modifiers."
    },
    "headline": {
      "type": "string",
      "description": "The grey first line of the menu: which account the title belongs to; empty without quota data."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "title",
          "logo",
          "columns",
          "rows",
          "more"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "logo": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "fillRule": {
                    "type": "string",
                    "enum": [
                      "nonzero",
                      "evenodd"
                    ]
                  },
                  "color": {
                    "type": "string",
                    "description": "Brand colour; without one the mark follows the text colour."
                  },
                  "gradients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "from",
                        "to",
                        "color"
                      ],
                      "properties": {
                        "from": {
                          "type": "array",
                          "additionalItems": false,
                          "items": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ],
                          "minItems": 2
                        },
                        "to": {
                          "type": "array",
                          "additionalItems": false,
                          "items": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ],
                          "minItems": 2
                        },
                        "color": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "Colour washes over a multicoloured mark: each fades from `color` at `from` to clear at `to`."
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "columns": {
            "type": "array",
            "additionalItems": false,
            "items": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            ],
            "minItems": 2,
            "description": "The window names over the two bar columns, such as `5h` and `7d`."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "label",
                "detail",
                "level",
                "recommended",
                "observedAt",
                "stale",
                "tip",
                "bars",
                "groups",
                "reset",
                "note"
              ],
              "properties": {
                "ref": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "detail": {
                  "type": "string",
                  "description": "The whole row as one line of text."
                },
                "level": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "ok"
                    },
                    {
                      "type": "string",
                      "const": "warn"
                    },
                    {
                      "type": "string",
                      "const": "fail"
                    },
                    {
                      "type": "string",
                      "const": "none"
                    }
                  ]
                },
                "recommended": {
                  "type": "boolean",
                  "description": "The account `sideby next` would pick in this Family."
                },
                "observedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "When the quota was observed, not checked."
                },
                "stale": {
                  "type": "boolean",
                  "description": "The quota is old, undated, or its last query failed."
                },
                "tip": {
                  "type": "string",
                  "description": "Hover text: when the numbers were read, each window's use and reset, and what a click does."
                },
                "bars": {
                  "anyOf": [
                    {
                      "type": "array",
                      "additionalItems": false,
                      "items": [
                        {
                          "anyOf": [
                            {
                              "type": "object",
                              "required": [
                                "label",
                                "percent",
                                "level"
                              ],
                              "properties": {
