                "reset": {
                  "type": "string",
                  "description": "Until the fullest window resets, such as `4d 17h`; empty when nothing is used."
                },
                "note": {
                  "type": "string",
                  "description": "A no-quota explanation, or an old-reading warning beside the bars."
                }
