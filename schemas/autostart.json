{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/autostart.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "supported",
    "state",
    "path",
    "current"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "supported": {
      "type": "boolean",
      "description": "False on a system sideby cannot start at login yet; `reason` says so."
    },
    "reason": {
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "const": "off"
        },
        {
          "type": "string",
          "const": "on"
        },
        {
          "type": "string",
          "const": "stale"
        },
        {
          "type": "string",
          "const": "foreign"
        }
      ],
      "description": "`stale`: the Node or sideby it starts no longer exists; `foreign`: a file at that path that sideby did not write."
    },
    "path": {
      "type": "string"
    },
    "mechanism": {
      "anyOf": [
        {
          "type": "string",
          "const": "launchd"
        },
        {
          "type": "string",
          "const": "xdg"
        },
        {
          "type": "string",
          "const": "wsl-startup"
        }
      ],
      "description": "How it starts at login: a LaunchAgent (macOS), an XDG autostart entry (Linux desktop sessions), or a script in the Windows Startup folder (WSL). Absent when unsupported."
    },
    "programArguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current": {
      "type": "boolean",
      "description": "The login item starts this sideby with this Node."
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "anyOf": [
        {
          "type": "string",
          "const": "on"
        },
        {
          "type": "string",
          "const": "off"
        }
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "applied": {
      "type": "boolean"
    },
    "content": {
      "type": "string",
      "description": "The file `on` writes."
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "loaded": {
      "type": "boolean",
      "description": "After a change: launchd took it now. In a status of the menu bar item: launchd holds it now; false means it is on but not running until `sideby menubar on` or the next login."
    },
    "note": {
      "type": "string"
    },
    "hotkey": {
      "type": "object",
      "required": [
        "keys",
        "label",
        "enabled",
        "isDefault",
        "registered"
      ],
      "properties": {
        "keys": {
          "type": "string",
          "description": "As config `menubar.hotkey` holds it, or the default: `opt+x`, `off`."
        },
        "label": {
          "type": "string",
          "description": "As macOS writes it, such as `⌥⌘S`; empty when off."
        },
        "enabled": {
          "type": "boolean"
        },
        "isDefault": {
          "type": "boolean"
        },
        "registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the menu bar item could register it: false means another app or macOS holds it; null when it has not said yet or it is off."
        },
        "problem": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "description": "A value config allows but a new choice would be refused for; it still works."
        }
      }
    },
    "icon": {
      "type": "object",
      "required": [
        "visible"
      ],
      "properties": {
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether macOS shows the menu bar icon right now: false when it sits behind « (the menu bar is full) or is covered; null when the item has not said in the last 15 minutes."
        }
      },
      "description": "Only while the menu bar item is on."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
