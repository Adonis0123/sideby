{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/plugins.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "plugins",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "source",
          "families",
          "configKeys"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "where",
          "message"
        ],
        "properties": {
          "where": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "sideby plugins --json"
}
