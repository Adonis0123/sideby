{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/ask.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "task",
    "account",
    "terminal",
    "opened",
    "command",
    "removedSecrets",
    "attachments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "account": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "opened": {
      "type": "boolean"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "removedSecrets": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "no-accounts",
        "none-signed-in",
        "all-full",
        "not-installed",
        "automation-denied",
        "npx-cache",
        "unsafe-path",
        "failed",
        "unsupported-platform"
      ],
      "description": "Why nothing opened (only when `opened` is false); `detail` says what to do next."
    },
    "detail": {
      "type": "string",
      "description": "What to do next, for a person."
    },
    "prompt": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path of the copy saved for the task."
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "Files given with `--attach`, in order; empty without any."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
