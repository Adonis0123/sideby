{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/app-uninstall.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "removed",
    "skipped"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "platform": {
      "anyOf": [
        {
          "type": "string",
          "const": "darwin"
        },
        {
          "type": "string",
          "const": "linux"
        }
      ]
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby app uninstall --json"
}
