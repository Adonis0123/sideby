{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/tune-change.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "account",
    "action",
    "applied"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "account": {
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "type": "string",
          "const": "apply"
        },
        {
          "type": "string",
          "const": "undo"
        }
      ]
    },
    "applied": {
      "type": "boolean",
      "description": "True once the change was written (or undone)."
    },
    "plan": {
      "type": "object",
      "required": [
        "status",
        "file",
        "link",
        "affected",
        "current",
        "next",
        "creates"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "ready"
            },
            {
              "type": "string",
              "const": "unchanged"
            },
            {
              "type": "string",
              "const": "blocked"
            }
          ]
        },
        "file": {
          "type": "string"
        },
        "link": {
          "type": "boolean"
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "creates": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "value"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "string"
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby tune apply|undo --json"
}
