{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/list.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "families",
    "accounts",
    "pluginErrors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "bin",
          "installUrl",
          "installed",
          "plugin",
          "tuning"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "bin": {
            "type": "string"
          },
          "installUrl": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          },
          "plugin": {
            "type": "string"
          },
          "tuning": {
            "type": "boolean"
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "family",
              "name",
              "ref",
              "dir",
              "isMain",
              "kind"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "dir": {
                "type": "string"
              },
              "isMain": {
                "type": "boolean"
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "subscription"
                  },
                  {
                    "type": "string",
                    "const": "api"
                  }
                ]
              },
              "secretFile": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "familyTitle",
              "hostInstalled",
              "login"
            ],
            "properties": {
              "familyTitle": {
                "type": "string"
              },
              "hostInstalled": {
                "type": "boolean"
              },
              "login": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "logged-in"
                  },
                  {
                    "type": "string",
                    "const": "logged-out"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  },
                  {
                    "type": "string",
                    "const": "not-needed"
                  }
                ]
              },
              "model": {
                "type": "string"
              },
              "identity": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "org": {
                    "type": "string"
                  }
                },
                "description": "Who the account is signed in as, from the host's login file: identity fields only, never a token (ADR-0003)."
              },
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "desktopApp": {
                "type": "object",
                "required": [
                  "app",
                  "installed",
                  "running"
                ],
                "properties": {
                  "app": {
                    "type": "string"
                  },
                  "installed": {
                    "type": "boolean"
                  },
                  "running": {
                    "type": "boolean"
                  }
                },
                "description": "The family's desktop app for this account (macOS, subscription accounts of claude and codex): whether it is installed and whether this account's own window runs now. Open it with `sideby desktop <account>`."
              }
            }
          }
        ]
      }
    },
    "pluginErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "where",
          "message"
        ],
        "properties": {
          "where": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "sideby list --json"
}
