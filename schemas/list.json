{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/list.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "families",
    "accounts",
    "pluginErrors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "bin",
          "installUrl",
          "installed",
          "plugin",
          "tuning"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "bin": {
            "type": "string"
          },
          "installUrl": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          },
          "plugin": {
            "type": "string"
          },
          "tuning": {
            "type": "boolean"
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "family",
              "name",
              "ref",
              "dir",
              "isMain",
              "kind"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "dir": {
                "type": "string"
              },
              "isMain": {
                "type": "boolean"
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "subscription"
                  },
                  {
                    "type": "string",
                    "const": "api"
                  }
                ]
              },
              "secretFile": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "familyTitle",
              "hostInstalled",
              "login"
            ],
            "properties": {
              "familyTitle": {
                "type": "string"
              },
              "hostInstalled": {
                "type": "boolean"
              },
              "login": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "logged-in"
                  },
                  {
                    "type": "string",
                    "const": "logged-out"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  },
                  {
                    "type": "string",
                    "const": "not-needed"
                  }
                ]
              },
              "model": {
                "type": "string"
              },
              "identity": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "org": {
                    "type": "string"
                  }
                },
                "description": "Who the account is signed in as, from the host's login file: identity fields only, never a token (ADR-0003)."
              },
              "sameLogin": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The other accounts signed in as the same login (same family, email and organization), which share one quota (spec §3.21). Absent when there are none."
              },
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "desktopApp": {
                "type": "object",
                "required": [
                  "app",
                  "installed",
                  "running"
                ],
                "properties": {
                  "app": {
                    "type": "string"
                  },
                  "installed": {
                    "type": "boolean"
                  },
                  "running": {
                    "type": "boolean"
                  }
                },
                "description": "The family's desktop app for this account (macOS, subscription accounts of claude and codex): whether it is installed and whether this account's own window runs now. Open it with `sideby desktop <account>`."
              }
            }
          }
        ]
      }
    },
    "appProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "app",
          "name",
          "isMain",
          "installed",
          "running"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "`grok-bot:<name>`; `grok-bot:main` is the app's own default data."
          },
          "app": {
            "type": "string",
            "description": "The app, for example `Grok Bot`."
          },
          "name": {
            "type": "string"
          },
          "isMain": {
            "type": "boolean"
          },
          "appData": {
            "type": "string",
            "description": "This window's data folder; absent for the main one, which uses the app's default."
          },
          "installed": {
            "type": "boolean"
          },
          "running": {
            "type": "boolean",
            "description": "This window's own instance runs now."
          },
          "signedIn": {
            "type": "boolean",
            "description": "What the app last wrote about its sign-in (it keeps the last value after the app quits); absent when unknown. Which account is signed in is not known."
          }
        },
        "description": "A window of a desktop app that signs in apart from every account (Grok Bot, ADR-0019). Open or create one with `sideby desktop grok-bot:<name>`."
      },
      "description": "Grok Bot windows (macOS, when Grok Bot is installed or has windows), the main one first. Not accounts."
    },
    "pluginErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "where",
          "message"
        ],
        "properties": {
          "where": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "sideby list --json"
}
