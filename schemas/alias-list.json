{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/alias-list.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "shortCommands"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "shortCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "account"
              },
              {
                "type": "string",
                "const": "pick"
              }
            ]
          },
          "account": {
            "type": "string",
            "description": "The Account a short command of kind `account` starts."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "family": {
            "type": "string",
            "description": "The Family a Pick Command picks in."
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby alias list --json"
}
