{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/menubar-start.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "task",
    "account",
    "terminal",
    "opened",
    "command"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "task": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "terminal": {
      "type": "string"
    },
    "opened": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "description": "The command the terminal runs; paste it into a terminal when `opened` is false."
    },
    "reason": {
      "type": "string",
      "enum": [
        "not-installed",
        "automation-denied",
        "npx-cache",
        "unsafe-path",
        "failed",
        "unsupported-platform"
      ]
    },
    "detail": {
      "type": "string",
      "description": "What to do next, for a person."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
