{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/browser-open.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ref",
    "url",
    "profile",
    "command"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ref": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": [
        "dir",
        "name"
      ],
      "properties": {
        "dir": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The `open` command sideby ran."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby browser open --json"
}
