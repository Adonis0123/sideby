{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/next.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "family",
    "pick",
    "accounts",
    "hasQuota"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "family": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "description": "The account `sideby next` runs in (SIDEBY_ACCOUNT, set by sideby for the sessions it starts), when it belongs to this family."
    },
    "pick": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The recommended account; null when none can be used now (exit code 1)."
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "kind",
          "state",
          "pressure"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "subscription"
              },
              {
                "type": "string",
                "const": "api"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "const": "ready"
              },
              {
                "type": "string",
                "const": "unknown"
              },
              {
                "type": "string",
                "const": "api"
              },
              {
                "type": "string",
                "const": "full"
              },
              {
                "type": "string",
                "const": "logged-out"
              }
            ],
            "description": "ready and unknown can be picked; api only with --include-api; full and logged-out never."
          },
          "pressure": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Used percent of the fullest window not reset yet; null without quota."
          },
          "resetsAt": {
            "type": "string",
            "description": "For full: when its last full window resets."
          },
          "observedAt": {
            "type": "string",
            "description": "When the account's quota was recorded (its last session)."
          },
          "quotaFrom": {
            "type": "string",
            "description": "The account the quota was read from, when it is another account of the same login."
          },
          "sameLoginAs": {
            "type": "string",
            "description": "The current account (`from`), when this one is signed in as the same login: it shares that quota and is never picked."
          }
        }
      },
      "description": "Every account of the family, best first."
    },
    "hasQuota": {
      "type": "boolean",
      "description": "False when no account has quota data: the pick is then a guess, and `sideby next` does not start it (exit 1)."
    },
    "earliestReset": {
      "type": "object",
      "required": [
        "ref",
        "at"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "description": "Set when nothing can be picked and some accounts are full: the first to come back."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby next --json"
}
