{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/new.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "account",
    "steps",
    "hookErrors",
    "nextSteps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "account": {
      "type": "object",
      "required": [
        "family",
        "name",
        "ref",
        "dir",
        "isMain",
        "kind"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "isMain": {
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "subscription"
            },
            {
              "type": "string",
              "const": "api"
            }
          ]
        },
        "secretFile": {
          "type": "string"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "action",
          "ok"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "hookErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "plugin",
          "message"
        ],
        "properties": {
          "plugin": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alias": {
      "type": "object",
      "required": [
        "name",
        "added"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "added": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "description": "The `--alias` short command; `added: false` means the Account exists without it."
    },
    "shellInitFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shell",
          "path",
          "ok"
        ],
        "properties": {
          "shell": {
            "anyOf": [
              {
                "type": "string",
                "const": "zsh"
              },
              {
                "type": "string",
                "const": "bash"
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "const": "written"
              },
              {
                "type": "string",
                "const": "unchanged"
              }
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "description": "One entry per config `shellInitFile`, rewritten after the change."
    },
    "suggestion": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "alias": {
          "type": "string"
        },
        "aliasProblem": {
          "type": "string"
        }
      },
      "description": "Only with `--next`: the picked name, the short command that follows the existing pattern, or why that short command was left out."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby new --json"
}
