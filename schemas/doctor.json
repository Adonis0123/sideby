{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/doctor.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "accounts",
    "general",
    "fixes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "ok"
        },
        {
          "type": "string",
          "const": "issues"
        }
      ]
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "family",
          "name",
          "kind",
          "dir",
          "shared",
          "backups",
          "findings"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "subscription"
              },
              {
                "type": "string",
                "const": "api"
              }
            ]
          },
          "dir": {
            "type": "string"
          },
          "shared": {
            "type": "object",
            "required": [
              "ok",
              "total"
            ],
            "properties": {
              "ok": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          },
          "backups": {
            "type": "number"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "level",
                "account",
                "item",
                "code",
                "message",
                "source",
                "fixable"
              ],
              "properties": {
                "level": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "ok"
                    },
                    {
                      "type": "string",
                      "const": "warn"
                    },
                    {
                      "type": "string",
                      "const": "fail"
                    }
                  ]
                },
                "account": {
                  "type": "string"
                },
                "item": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "fixable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "general": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "account",
          "item",
          "code",
          "message",
          "source",
          "fixable"
        ],
        "properties": {
          "level": {
            "anyOf": [
              {
                "type": "string",
                "const": "ok"
              },
              {
                "type": "string",
                "const": "warn"
              },
              {
                "type": "string",
                "const": "fail"
              }
            ]
          },
          "account": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "fixable": {
            "type": "boolean"
          }
        }
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account",
          "item",
          "code",
          "ok",
          "message"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby doctor --json"
}
