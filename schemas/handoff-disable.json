{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/handoff-disable.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "applied",
    "file",
    "diff",
    "settings",
    "nextSteps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "applied": {
      "type": "boolean"
    },
    "file": {
      "type": "string"
    },
    "diff": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "required": [
        "auto",
        "sameFamily",
        "otherFamilies",
        "familyOrder",
        "api",
        "prepareAt",
        "threshold",
        "adaptive",
        "waitIfResetWithinMinutes",
        "countdownSeconds",
        "crossOrganization",
        "families"
      ],
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "sameFamily": {
          "type": "boolean"
        },
        "otherFamilies": {
          "type": "boolean",
          "description": "Other AIs may take over when this one has no account that can (ADR-0046)."
        },
        "familyOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The order other AIs are tried in."
        },
        "api": {
          "type": "boolean",
          "description": "API accounts may take over, last; billed per use (ADR-0046)."
        },
        "prepareAt": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "adaptive": {
          "type": "boolean"
        },
        "waitIfResetWithinMinutes": {
          "type": "number"
        },
        "countdownSeconds": {
          "type": "number"
        },
        "crossOrganization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "families": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "required": [
                "policy",
                "order"
              ],
              "properties": {
                "policy": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "pressure"
                    },
                    {
                      "type": "string",
                      "const": "order"
                    }
                  ]
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby handoff disable --json"
}
