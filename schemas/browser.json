{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/browser.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "enabled",
    "browser",
    "found",
    "profiles",
    "families",
    "problems"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "config `browser.signIns`. When false nothing of the browser was read and `profiles` is empty."
    },
    "browser": {
      "type": "string",
      "description": "The browser read, `Google Chrome`."
    },
    "found": {
      "type": "boolean",
      "description": "Chrome's user data folder exists on this Mac."
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dir",
          "name",
          "signIns"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "description": "The browser user's folder, such as `Default` or `Profile 7`."
          },
          "name": {
            "type": "string",
            "description": "The name Chrome shows; it may be an email."
          },
          "email": {
            "type": "string",
            "description": "The Google account this browser user is signed in to Chrome with."
          },
          "signIns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Refs of the accounts this browser user signed in to on the vendor's website, as far as its local data shows; it may be left over from before a sign-out."
          },
          "changedAt": {
            "type": "string",
            "description": "When its Local Storage last changed (ISO 8601)."
          }
        }
      },
      "description": "Most recently changed first."
    },
    "families": {
      "type": "object",
      "required": [
        "matched",
        "openOnly"
      ],
      "properties": {
        "matched": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Families whose accounts can be matched (claude, codex)."
        },
        "openOnly": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Families that can only be opened in a browser user given with --profile (grok)."
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby browser --json"
}
