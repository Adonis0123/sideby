{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/theme.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "folder",
    "themes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "folder": {
      "type": "string",
      "description": "Where Theme Files go, with ~ for the home folder."
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "active",
          "problems",
          "warnings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The name to pass to `sideby theme use`."
          },
          "name": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "builtin"
              },
              {
                "type": "string",
                "const": "file"
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Why the Theme cannot be used; empty when it can."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Keys of the file that were ignored."
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
