{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/shell-init-setup.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "shell",
    "rc",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "shell": {
      "anyOf": [
        {
          "type": "string",
          "const": "zsh"
        },
        {
          "type": "string",
          "const": "bash"
        }
      ]
    },
    "rc": {
      "type": "string",
      "description": "The rc file, with ~ for the home folder."
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "loaded"
        },
        {
          "type": "string",
          "const": "confirm"
        },
        {
          "type": "string",
          "const": "added"
        },
        {
          "type": "string",
          "const": "removed"
        },
        {
          "type": "string",
          "const": "not-added"
        }
      ],
      "description": "`loaded`: new terminals already load the short commands. `confirm` (exit 10): nothing written; `block` is what --yes appends. `not-added`: --undo found no line sideby added."
    },
    "block": {
      "type": "string"
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby shell-init setup --json"
}
