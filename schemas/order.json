{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/order.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "display",
    "families"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "display": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accounts": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "pinned": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "hiddenFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "hidden",
          "accounts"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "ref",
                "pinned",
                "hidden"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "pinned": {
                  "type": "boolean"
                },
                "hidden": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
