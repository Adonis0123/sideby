{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/update.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "current",
    "latest",
    "available",
    "method",
    "command",
    "canRun",
    "releaseNotes",
    "updated"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "current": {
      "type": "string",
      "description": "The running sideby version."
    },
    "latest": {
      "type": "string",
      "description": "The `latest` version on the npm registry."
    },
    "available": {
      "type": "boolean",
      "description": "`latest` is newer than `current`."
    },
    "method": {
      "type": "object",
      "required": [
        "kind",
        "canUpdate"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "npm"
            },
            {
              "type": "string",
              "const": "pnpm"
            },
            {
              "type": "string",
              "const": "bun"
            },
            {
              "type": "string",
              "const": "volta"
            },
            {
              "type": "string",
              "const": "npx"
            },
            {
              "type": "string",
              "const": "project"
            },
            {
              "type": "string",
              "const": "source"
            }
          ],
          "description": "How this copy was installed."
        },
        "canUpdate": {
          "type": "boolean",
          "description": "sideby can run the Update itself."
        },
        "reason": {
          "type": "string",
          "description": "Why it cannot."
        }
      }
    },
    "command": {
      "type": "string",
      "description": "What an Update runs, or what to run by hand when `canRun` is false."
    },
    "canRun": {
      "type": "boolean"
    },
    "releaseNotes": {
      "type": "string",
      "description": "The release notes of `latest`."
    },
    "updated": {
      "type": "boolean",
      "description": "False when only the plan was shown (exit 10 with --yes still to add) or nothing to do."
    },
    "message": {
      "type": "string"
    },
    "restartedPanel": {
      "type": "boolean",
      "description": "A background Panel was running and starts again with the new version."
    },
    "refreshedApp": {
      "type": "boolean",
      "description": "The desktop app (`sideby app install`) was installed and was written again by the new version."
    },
    "skill": {
      "type": "string",
      "description": "The command that updates the sideby skill; sideby never runs it."
    },
    "output": {
      "type": "string",
      "description": "What the failed install command printed."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby update --json"
}
