{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/update.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "current",
    "latest",
    "available",
    "method",
    "command",
    "canRun",
    "releaseNotes",
    "updated"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "current": {
      "type": "string",
      "description": "The running sideby version."
    },
    "latest": {
      "type": "string",
      "description": "The `latest` version on the npm registry."
    },
    "available": {
      "type": "boolean",
      "description": "`latest` is newer than `current`."
    },
    "method": {
      "type": "object",
      "required": [
        "kind",
        "canUpdate"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "npm"
            },
            {
              "type": "string",
              "const": "pnpm"
            },
            {
              "type": "string",
              "const": "bun"
            },
            {
              "type": "string",
              "const": "volta"
            },
            {
              "type": "string",
              "const": "npx"
            },
            {
              "type": "string",
              "const": "project"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "local"
            }
          ],
          "description": "How this copy was installed."
        },
        "canUpdate": {
          "type": "boolean",
          "description": "sideby can run the Update itself."
        },
        "reason": {
          "type": "string",
          "description": "Why it cannot."
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "const": "local-build"
            },
            {
              "type": "string",
              "const": "npx"
            },
            {
              "type": "string",
              "const": "volta"
            },
            {
              "type": "string",
              "const": "not-writable"
            },
            {
              "type": "string",
              "const": "project"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "skill-in-git"
            }
          ],
          "description": "Why, as a code a page can say in its own language."
        },
        "reasonAt": {
          "type": "string",
          "description": "The folders that are not writable (`not-writable`)."
        }
      }
    },
    "command": {
      "type": "string",
      "description": "What an Update runs, or what to run by hand when `canRun` is false."
    },
    "canRun": {
      "type": "boolean"
    },
    "releaseNotes": {
      "type": "string",
      "description": "The release notes of `latest`."
    },
    "updated": {
      "type": "boolean",
      "description": "False when only the plan was shown (exit 10 with --yes still to add) or nothing to do."
    },
    "message": {
      "type": "string"
    },
    "restartedPanel": {
      "type": "boolean",
      "description": "A background Panel was running and starts again with the new version."
    },
    "refreshedApp": {
      "type": "boolean",
      "description": "The desktop app (`sideby app install`) was installed and was written again by the new version."
    },
    "refreshedAutostart": {
      "type": "boolean",
      "description": "A login item (`sideby autostart on`) was installed and now starts the new version (false: that failed). Absent without one."
    },
    "skill": {
      "type": "string",
      "description": "The command that installs the sideby skill by hand."
    },
    "skillUpdate": {
      "type": "object",
      "required": [
        "installed",
        "outdated",
        "command",
        "canRun"
      ],
      "properties": {
        "installed": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Versions of the installed sideby skills; null for one without a version."
        },
        "outdated": {
          "type": "boolean",
          "description": "Some installed skill is for another version than sideby will run."
        },
        "command": {
          "type": "string"
        },
        "canRun": {
          "type": "boolean",
          "description": "False when sideby leaves the skill alone (see reason): give the user command."
        },
        "reason": {
          "type": "string"
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "const": "local-build"
            },
            {
              "type": "string",
              "const": "npx"
            },
            {
              "type": "string",
              "const": "volta"
            },
            {
              "type": "string",
              "const": "not-writable"
            },
            {
              "type": "string",
              "const": "project"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "skill-in-git"
            }
          ],
          "description": "Why, as a code a page can say in its own language."
        },
        "reasonAt": {
          "type": "string",
          "description": "The git repository that owns the skill (`skill-in-git`)."
        }
      },
      "description": "The installed sideby skill, which the Update brings along; absent when none is installed."
    },
    "skillUpdated": {
      "type": "boolean",
      "description": "The skill was updated too (true) or that failed (false); absent when not tried."
    },
    "output": {
      "type": "string",
      "description": "What the failed install command printed."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby update --json"
}
