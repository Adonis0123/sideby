{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/desktop-remove.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ref",
    "app",
    "appData",
    "removed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ref": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "appData": {
      "type": "string",
      "description": "The folder that is (or would be) deleted."
    },
    "removed": {
      "type": "boolean",
      "description": "False when only the plan was shown; run again with --yes (exit 10)."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby desktop grok-bot:<name> --remove --json"
}
