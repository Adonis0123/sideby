{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/theme-check.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "ok",
    "pairs",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "ok": {
      "type": "boolean",
      "description": "Every pair passes; the command exits 1 otherwise."
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mode",
          "fg",
          "bg",
          "min",
          "ok"
        ],
        "properties": {
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "const": "light"
              },
              {
                "type": "string",
                "const": "dark"
              }
            ]
          },
          "fg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "ratio": {
            "type": "number",
            "description": "WCAG 2 contrast; missing when a value is not #rrggbb."
          },
          "min": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "suggest": {
            "type": "string",
            "description": "A value for fg that passes."
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
