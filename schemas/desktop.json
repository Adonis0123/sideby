{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/desktop.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ref",
    "family",
    "app",
    "appPath",
    "action",
    "createdAppData",
    "linked",
    "notices"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ref": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "description": "The family, or `grok-bot` for a Grok Bot window."
    },
    "app": {
      "type": "string",
      "description": "The desktop app, for example `Claude Desktop`."
    },
    "appPath": {
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "type": "string",
          "const": "started"
        },
        {
          "type": "string",
          "const": "focused"
        },
        {
          "type": "string",
          "const": "already-running"
        }
      ],
      "description": "`started`: a new window for this account; `focused`: its running window was brought to the front; `already-running`: it runs but could not be brought to the front."
    },
    "appData": {
      "type": "string",
      "description": "This account's app data folder; absent for the main account, which uses the app's default."
    },
    "createdAppData": {
      "type": "boolean"
    },
    "linked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files linked into a new app data folder from the main account's (claude_desktop_config.json)."
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The `open` command sideby ran."
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby desktop --json"
}
