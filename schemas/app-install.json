{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/app-install.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "path",
    "files",
    "mode",
    "node",
    "entry",
    "updated",
    "hints"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "platform": {
      "anyOf": [
        {
          "type": "string",
          "const": "darwin"
        },
        {
          "type": "string",
          "const": "linux"
        }
      ]
    },
    "path": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "const": "panel"
        },
        {
          "type": "string",
          "const": "url"
        }
      ]
    },
    "url": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "updated": {
      "type": "boolean"
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby app install --json"
}
