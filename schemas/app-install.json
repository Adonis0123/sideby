{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/app-install.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "path",
    "files",
    "mode",
    "node",
    "entry",
    "updated",
    "hints"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "platform": {
      "anyOf": [
        {
          "type": "string",
          "const": "darwin"
        },
        {
          "type": "string",
          "const": "linux"
        }
      ]
    },
    "path": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "const": "panel"
        },
        {
          "type": "string",
          "const": "url"
        }
      ]
    },
    "url": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "updated": {
      "type": "boolean"
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "sideby app install --json"
}
