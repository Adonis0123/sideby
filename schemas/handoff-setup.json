{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/handoff-setup.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "family",
    "applied",
    "plan"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "family": {
      "type": "string"
    },
    "applied": {
      "type": "boolean"
    },
    "plan": {
      "type": "object",
      "required": [
        "status",
        "file",
        "diff",
        "message"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "enabled"
            },
            {
              "type": "string",
              "const": "ready"
            },
            {
              "type": "string",
              "const": "blocked"
            }
          ]
        },
        "file": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Updates the installed sideby skill (run it after the user agrees)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby handoff setup --json"
}
