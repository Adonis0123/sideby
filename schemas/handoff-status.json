{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/handoff-status.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "auto",
    "sameFamily",
    "prepareAt",
    "threshold",
    "sideby",
    "families",
    "nextSteps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "overview": {
      "type": "object",
      "required": [
        "settings",
        "takeover",
        "recent"
      ],
      "properties": {
        "settings": {
          "type": "object",
          "required": [
            "auto",
            "sameFamily",
            "otherFamilies",
            "familyOrder",
            "api",
            "prepareAt",
            "threshold",
            "adaptive",
            "waitIfResetWithinMinutes",
            "countdownSeconds",
            "crossOrganization",
            "families"
          ],
          "properties": {
            "auto": {
              "type": "boolean"
            },
            "sameFamily": {
              "type": "boolean"
            },
            "otherFamilies": {
              "type": "boolean",
              "description": "Other AIs may take over when this one has no account that can (ADR-0046)."
            },
            "familyOrder": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The order other AIs are tried in."
            },
            "api": {
              "type": "boolean",
              "description": "API accounts may take over, last; billed per use (ADR-0046)."
            },
            "prepareAt": {
              "type": "number"
            },
            "threshold": {
              "type": "number"
            },
            "adaptive": {
              "type": "boolean"
            },
            "waitIfResetWithinMinutes": {
              "type": "number"
            },
            "countdownSeconds": {
              "type": "number"
            },
            "crossOrganization": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "families": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "object",
                  "required": [
                    "policy",
                    "order"
                  ],
                  "properties": {
                    "policy": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "pressure"
                        },
                        {
                          "type": "string",
                          "const": "order"
                        }
                      ]
                    },
                    "order": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "takeover": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "family",
              "starts",
              "decision"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "starts": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "quota"
                    },
                    {
                      "type": "string",
                      "const": "limit"
                    }
                  ]
                }
              },
              "decision": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "ref"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pick"
                      },
                      "ref": {
                        "type": "string"
                      },
                      "skipped": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "ref",
                            "reason"
                          ],
                          "properties": {
                            "ref": {
                              "type": "string"
                            },
                            "reason": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "until"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "wait"
                      },
                      "until": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "reason"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "none"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "earliestReset": {
                        "type": "object",
                        "required": [
                          "ref",
                          "at"
                        ],
                        "properties": {
                          "ref": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string"
                          }
                        }
                      },
                      "skipped": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "ref",
                            "reason"
                          ],
                          "properties": {
                            "ref": {
                              "type": "string"
                            },
                            "reason": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "at",
              "trigger",
              "briefSource"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "trigger": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "threshold"
                  },
                  {
                    "type": "string",
                    "const": "limit"
                  },
                  {
                    "type": "string",
                    "const": "manual"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "briefSource": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "agent"
                  },
                  {
                    "type": "string",
                    "const": "sideby"
                  },
                  {
                    "type": "string",
                    "const": "user"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "apiUndecided": {
      "type": "boolean",
      "description": "Auto Handoff was on with API accounts before they became opt-in (ADR-0046): ask the user once whether they may take over, then set handoff.api."
    },
    "auto": {
      "type": "boolean"
    },
    "sameFamily": {
      "type": "boolean"
    },
    "prepareAt": {
      "type": "number"
    },
    "threshold": {
      "type": "number"
    },
    "sideby": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "problem": {
          "type": "string"
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "starts",
          "ready",
          "problems",
          "notes",
          "order"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "starts": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "quota"
                },
                {
                  "type": "string",
                  "const": "limit"
                }
              ]
            }
          },
          "ready": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "order": {
            "type": "object",
            "required": [
              "policy",
              "order",
              "unknown"
            ],
            "properties": {
              "policy": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "pressure"
                  },
                  {
                    "type": "string",
                    "const": "order"
                  }
                ]
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unknown": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby handoff status --json"
}
