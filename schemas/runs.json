{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/runs.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "state",
          "activeLanes",
          "totalLanes",
          "openAsks",
          "runningWaits",
          "stepsDone",
          "stepsTotal",
          "dir"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "const": "active"
              },
              {
                "type": "string",
                "const": "closed"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "activeLanes": {
            "type": "integer"
          },
          "totalLanes": {
            "type": "integer"
          },
          "openAsks": {
            "type": "integer"
          },
          "runningWaits": {
            "type": "integer"
          },
          "stepsDone": {
            "type": "integer"
          },
          "stepsTotal": {
            "type": "integer"
          },
          "coordinator": {
            "type": "string"
          },
          "coordinatorSession": {
            "type": "string"
          },
          "dir": {
            "type": "string"
          }
        }
      }
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  }
}
