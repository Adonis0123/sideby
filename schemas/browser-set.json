{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sideby/browser-set.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ref",
    "profile",
    "changed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ref": {
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "dir",
            "name"
          ],
          "properties": {
            "dir": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The browser user now chosen, or null with --auto (sideby finds it again by itself)."
    },
    "changed": {
      "type": "boolean",
      "description": "False when config already said so."
    },
    "_notice": {
      "type": "object",
      "properties": {
        "update": {
          "type": "object",
          "required": [
            "current",
            "latest",
            "command",
            "message"
          ],
          "properties": {
            "current": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "Run it after the user agrees: it shows the plan and exits 10; then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skill": {
          "type": "object",
          "required": [
            "installed",
            "current",
            "command",
            "message"
          ],
          "properties": {
            "installed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The skill's version; null when it has none."
            },
            "current": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "description": "`sideby update`, which updates the skill with sideby: run it after the user agrees; it shows the plan and exits 10, then --yes."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "description": "Not the answer to the task: mention it briefly afterwards and offer to update."
    }
  },
  "title": "sideby browser set --json"
}
