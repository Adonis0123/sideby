{
  "name": "sideby",
  "version": "0.1.0",
  "description": "Run every AI coding account side by side: Claude Code, Codex, Grok and pi, with one shared config and a quota panel.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "pi",
    "multi-account",
    "ai-coding",
    "cli",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adonis0123/sideby.git"
  },
  "homepage": "https://github.com/Adonis0123/sideby#readme",
  "bugs": "https://github.com/Adonis0123/sideby/issues",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "sideby": "./dist/src/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/src/cli/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-concurrency=4 \"src/**/*.test.ts\" \"testing/**/*.test.ts\"",
    "schemas": "node src/cli/schemas.ts",
    "leak-check": "sh scripts/leak-check.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm leak-check"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.15.0"
}
